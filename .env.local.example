# Copy this file to .env.local and fill in your own values.
# Never commit .env.local.

# --- Supabase ---------------------------------------------------------
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — used by the /api/books/*, /api/records, /api/reading-sessions
# routes to write data (after checking the request is signed in).
# Project Settings → API → service_role key. NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Auth ---------------------------------------------------------------
# Used to build the magic-link redirect URL. In local dev this defaults to
# http://localhost:3000 if left blank, so you only need to set it for a
# real deployment (e.g. https://uaje.yourdomain.com).
# Also add this exact URL + "/auth/callback" to Supabase → Authentication →
# URL Configuration → Redirect URLs, or the magic link will fail to sign in.
NEXT_PUBLIC_SITE_URL=

# --- Vision (book-cover recognition) -----------------------------------
# Optional. Without this, POST /api/books/identify responds with a clear
# "vision 연동이 필요해요" message instead of ever faking a recognition result.
# If set, /api/books/identify calls the Anthropic API with an image input.
# Check https://docs.claude.com for the current model id to put in
# ANTHROPIC_VISION_MODEL below — do not guess an id here.
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=

# --- Book search (optional) --------------------------------------------
# /api/books/search always searches your own Supabase `books` table first
# (duplicate detection). For new-book results it also calls the Google
# Books API, which works keyless at low volume. Set this only if you hit
# Google's rate limit and want a higher quota.
GOOGLE_BOOKS_API_KEY=
